<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- keyboard styles -->

    <style name="kbd_icon">
        <item name="android:layout_width">@dimen/kbd_icon_button_size</item>
        <item name="android:layout_height">@dimen/kbd_icon_button_size</item>
        <item name="android:layout_marginStart">@dimen/kbd_icon_h_margin</item>
        <item name="android:layout_marginEnd">@dimen/kbd_icon_h_margin</item>
        <item name="android:paddingStart">@dimen/kdb_icon_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/kdb_icon_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/kdb_icon_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/kdb_icon_padding_vertical</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:tint">?attr/kbd_text_color</item>
    </style>

    <style name="kbd_style_picker_option">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/kbd_style_picker_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/kbd_style_picker_horizontal_padding</item>
        <item name="android:textColor">?attr/kbd_text_color</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <!-- main activity styles -->

    <style name="main_scroll_view">
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:layout_width">@dimen/match_parent</item>
        <item name="android:layout_height">@dimen/match_parent</item>
        <item name="android:background">@drawable/bg_gradient</item>
    </style>

    <style name="main_linear">
        <item name="android:layout_width">@dimen/match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="main_header">
        <item name="android:layout_width">@dimen/match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/main_element_spacing</item>
        <item name="android:padding">@dimen/main_element_spacing</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:text">@string/intro_header</item>
    </style>

    <style name="main_card_container" parent="@style/main_linear">
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_width">@dimen/match_parent</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="main_intro_card_gutter">
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">@dimen/main_card_width</item>
        <item name="android:layout_height">@dimen/match_parent</item>
        <item name="android:layout_width">0dp</item>
    </style>

    <style name="main_intro_card">
        <item name="android:layout_weight">8</item>
        <item name="android:maxWidth">@dimen/main_card_width</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">@dimen/main_element_spacing</item>
        <item name="android:paddingBottom">@dimen/main_element_spacing_2x</item>
        <item name="android:background">@drawable/bg_main_layout</item>
    </style>

    <style name="main_icon">
        <item name="android:layout_width">@dimen/main_icon_size</item>
        <item name="android:layout_height">@dimen/main_icon_size</item>
        <item name="android:layout_marginTop">@dimen/main_element_spacing_2x</item>
    </style>

    <style name="main_card_text_view">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/main_element_spacing</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="main_card_text_view_1" parent="@style/main_card_text_view">
        <item name="android:text">@string/intro_subtitle</item>
    </style>

    <style name="main_card_text_view_2" parent="@style/main_card_text_view">
        <item name="android:text">@string/now_try_it</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="main_card_button">
        <item name="android:enabled">false</item>
        <item name="android:maxWidth">@dimen/main_card_width</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginStart">@dimen/main_element_spacing</item>
        <item name="android:layout_marginEnd">@dimen/main_element_spacing</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="main_card_button_1" parent="@style/main_card_button">
        <item name="android:text">@string/enable_keyboard</item>
    </style>

    <style name="main_card_button_2" parent="@style/main_card_button">
        <item name="android:text">@string/select_keyboard</item>
    </style>

    <style name="config_order_btn">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/icon_color</item>
    </style>
</resources>
