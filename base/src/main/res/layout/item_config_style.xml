<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/style_config_row_minHeight"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:background="@drawable/bg_config_item">

    <TextView
        android:id="@+id/text_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="4dp" />

    <ImageButton
        android:id="@+id/order_btn_down"
        style="@style/config_order_btn"
        android:src="@drawable/pref_ic_arrow_down" />

    <ImageButton
        android:id="@+id/order_btn_up"
        style="@style/config_order_btn"
        android:src="@drawable/pref_ic_arrow_up" />

    <Switch
        android:id="@+id/enable_box"
        android:layout_width="wrap_content"
        android:layout_height="48dp" />
</LinearLayout>
