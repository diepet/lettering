<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_content"
    style="@style/main_scroll_view">

    <LinearLayout style="@style/main_linear">

        <TextView style="@style/main_header" />

        <LinearLayout style="@style/main_card_container">

            <View style="@style/main_intro_card_gutter" />

            <LinearLayout style="@style/main_intro_card"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/icon"
                    android:src="@drawable/ic_icon_round"
                    android:importantForAccessibility="no"
                    style="@style/main_icon" />

                <TextView
                    android:id="@+id/header"
                    style="@style/main_card_text_view_1" />

                <Button
                    android:id="@+id/step_1"
                    style="@style/main_card_button_1" />

                <Button
                    android:id="@+id/step_2"
                    style="@style/main_card_button_2" />

                <TextView
                    android:id="@+id/try_hint"
                    android:labelFor="@id/test_input"
                    style="@style/main_card_text_view_2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/main_element_spacing"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/test_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="textMultiLine"
                        android:importantForAutofill="no"
                        android:lines="@integer/main_input_lines" />
                    <ImageButton
                        android:id="@+id/clear_input"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/clear_text"
                        android:tint="@color/icon_color"
                        android:src="@android:drawable/ic_menu_close_clear_cancel" />
                </LinearLayout>

            </LinearLayout>

            <View style="@style/main_intro_card_gutter" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
